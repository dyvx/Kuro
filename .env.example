# ──────────────────────────────────────────────────────────────
# KURO — environment configuration
# Copy to .env.local and fill in values.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# MongoDB Atlas connection string (recommended) or local MongoDB.
# If left EMPTY, the app runs with an in-memory store (great for demos,
# data resets on restart).
MONGODB_URI=
DATABASE_NAME=kuro

# ── Anime data provider ──────────────────────────────────────
# Which provider adapter to use: "demo" | "anivexa"
#   demo    — bundled offline catalog with public test streams (no key needed)
#   anivexa — AniList metadata + YOUR self-hosted Anivexa-API for streams
#             (github.com/walterwhite-69/Anivexa-API — multi-provider, sub/dub)
ANIME_PROVIDER=demo

# Base URL of your Anivexa instance (e.g. your Render deployment).
ANIME_API_BASE_URL=

# Optional additional STREAM source + SEARCH RESOLVER: Kuhi
# (github.com/aryaniiil/anime-api). Streams: races 10 native providers per
# play, direct HLS/MP4 + subtitles. Search: resolves titles AniList's search
# misses (pinyin/alternate names) back to AniList IDs. Leave empty to disable.
ANIME_KUHI_BASE_URL=

# ── Auth (NextAuth) ──────────────────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev:  http://localhost:3000   |   Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AniSkip (optional skip-time enhancement; failures never affect playback) ──
ANISKIP_BASE_URL=https://api.aniskip.com


# Optional additional stream source: Kuhi (github.com/aryaniiil/anime-api),
# races 10 providers per play and returns direct HLS/MP4 + subtitles.
# Point at your own Kuhi instance; leave empty to disable.
ANIME_KUHI_BASE_URL=
