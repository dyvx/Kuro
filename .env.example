# ──────────────────────────────────────────────────────────────
# KURO — environment configuration
# Copy to .env.local and fill in values.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# MongoDB Atlas connection string (recommended) or local MongoDB.
# If left EMPTY, the app runs with an in-memory store (great for demos,
# data resets on restart).
MONGODB_URI=
DATABASE_NAME=kuro

# ── Anime data provider ──────────────────────────────────────
# Which provider adapter to use: "demo" | "consumet" | "anify"
#   demo    — bundled offline catalog with public test streams (no key needed)
#   consumet — Consumet API (self-hosted instance recommended)
#   anify   — Anify API
ANIME_PROVIDER=demo

# Base URL of your Consumet / Anify instance.
# Consumet example:  http://localhost:4100  (self-hosted) or your hosted URL
# Anify example:     https://api.anify.it
ANIME_API_BASE_URL=

# Optional API key, required by some Anify deployments.
ANIME_API_KEY=

# Consumet: which streaming provider to extract sources from
# (e.g. "gogoanime", "zoro"). Only used by the consumet adapter.
CONSUMET_STREAMING_PROVIDER=gogoanime

# ── Auth (NextAuth) ──────────────────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev:  http://localhost:3000   |   Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
